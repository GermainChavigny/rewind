#!/usr/bin/env bash
# Install (or remove) the v1/v2 boot menu on the tty1 console.
#
#   ./install-boot-menu            install
#   ./install-boot-menu --remove   restore the original ~/.bash_profile
#
# The original ~/.bash_profile is backed up as ~/.bash_profile.rewind-backup.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
PROFILE="$HOME/.bash_profile"
BACKUP="$HOME/.bash_profile.rewind-backup"
BIN="$HOME/.local/bin"

if [ "${1:-}" = "--remove" ]; then
  [ -f "$BACKUP" ] || { echo "No backup found ($BACKUP)." >&2; exit 1; }
  mv "$BACKUP" "$PROFILE"
  rm -f "$BIN/tv-switch"
  echo "Boot menu removed, ~/.bash_profile restored."
  exit 0
fi

mkdir -p "$BIN"
ln -sf "$HERE/tv-switch" "$BIN/tv-switch"
[ -f "$BACKUP" ] || cp "$PROFILE" "$BACKUP"

cat > "$PROFILE" <<PROFILE
# Generated by REWIND (install-boot-menu). Original: $BACKUP
export PATH="\$HOME/.local/bin:\$PATH"

# Physical console (tty1) only, never over SSH.
if [ -z "\${DISPLAY:-}" ] && [ "\$(tty)" = "/dev/tty1" ]; then
    if [ -x "$HERE/rewind-boot" ]; then
        "$HERE/rewind-boot" || startx
    else
        startx
    fi
fi
PROFILE
echo "Boot menu installed. Takes effect on the next TV boot."
