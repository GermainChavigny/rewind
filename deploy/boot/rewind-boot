#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# REWIND — v1 / v2 boot selector (teletext style).
#
# Started on the tty1 console from ~/.bash_profile, instead of `startx`.
# Remote-control friendly: arrows + OK, or keys 1 / 2.
# With no input, boots the default program (v1) after a few seconds.
# When the graphical session ends, we come back to the menu.
#
# The default is read from ~/.config/rewind/boot-default ("v1"|"v2") and can
# be changed with `tv-switch`.
#
# SAFETY RULE: any unexpected error → boot v1, exactly like before the menu
# was installed. The TV must never get stuck.
#
# On-screen texts are in French (UI language); comments are in English.
# ---------------------------------------------------------------------------


CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rewind"
DEFAULT_FILE="$CONF_DIR/boot-default"
DELAY="${REWIND_BOOT_DELAY:-5}"
DRY_RUN="${REWIND_BOOT_DRY_RUN:-0}"   # 1 = print the command instead of running it (tests)
V2_LAUNCHER="${REWIND_V2_LAUNCHER:-$HOME/rewind/deploy/kiosk/start-v2}"

launch_v1() {
  if [ "$DRY_RUN" = 1 ]; then echo "LAUNCH v1"; return 0; fi
  startx
}

launch_v2() {
  if [ "$DRY_RUN" = 1 ]; then echo "LAUNCH v2"; return 0; fi
  if [ -x "$V2_LAUNCHER" ]; then
    "$V2_LAUNCHER"
  else
    technical_difficulties
    return 1
  fi
}

# --- Display ---------------------------------------------------------------

E=$'\e'
BG="${E}[44m"; YEL="${E}[1;33m"; WHT="${E}[1;37m"; CYA="${E}[1;36m"
BLK_ON_YEL="${E}[30;43m"; BLK_ON_CYA="${E}[30;46m"; RST="${E}[0m"

cols() { tput cols 2>/dev/null || echo 80; }
rows() { tput lines 2>/dev/null || echo 24; }

# Print a full-width line on a blue background (pre-colored text allowed).
line() {
  local text="$1" plain width pad
  plain="$(printf '%s' "$text" | sed "s/${E}\[[0-9;]*m//g")"
  width=$(cols)
  pad=$(( width - ${#plain} ))
  (( pad < 0 )) && pad=0
  printf '%s%s%s%*s%s\n' "$BG" "$text" "$BG" "$pad" '' "$RST"
}

clear_blue() {
  printf '%s%s[2J%s[H' "$BG" "$E" "$E"
  local i
  for (( i = 0; i < $(rows); i++ )); do line ""; done
  printf '%s[H' "$E"
}

draw() {
  local selected="$1" countdown="$2" default="$3"
  local now; now="$(LC_TIME=fr_FR.UTF-8 date '+%a %d %b  %H:%M:%S')"
  printf '%s[H' "$E"
  line "${WHT} P100  REWIND  TÉLÉTEXTE        ${YEL}${now}"
  line ""
  line "  ${BLK_ON_YEL}  R E W I N D  ${BG}${CYA}  video system"
  line ""
  line "  ${CYA}CHOISISSEZ VOTRE PROGRAMME"
  line ""
  local v1="  1 ....... REWIND v1   (version actuelle) "
  local v2="  2 ....... REWIND v2   (en développement) "
  if [ "$selected" = v1 ]; then line "  ${BLK_ON_CYA}${v1}"; else line "  ${WHT}${v1}"; fi
  if [ "$selected" = v2 ]; then line "  ${BLK_ON_CYA}${v2}"; else line "  ${WHT}${v2}"; fi
  line ""
  line ""
  line "  ${YEL}Démarrage de ${selected} dans ${countdown} s ..."
  line ""
  line "  ${WHT}Touche 1 ou 2 : lancer tout de suite"
  line "  ${WHT}Flèches : changer de programme"
  line ""
  line "  ${WHT}Par défaut : ${default}   (changer : tv-switch v1|v2)"
}

technical_difficulties() {
  clear_blue
  line ""; line ""
  line "    ${BLK_ON_YEL}  TECHNICAL DIFFICULTIES  "
  line ""
  line "    ${WHT}REWIND v2 n'est pas encore installée sur ce poste."
  line "    ${WHT}please stand by ... retour au menu"
  sleep 4
}

# --- Keyboard / remote -----------------------------------------------------

# Read one key with a timeout; prints up|down|ok|1|2|other, or "" on timeout.
read_key() {
  local timeout="$1" k rest
  IFS= read -rsn1 -t "$timeout" k || { echo ""; return; }
  case "$k" in
    $'\e')
      IFS= read -rsn2 -t 0.05 rest || true
      case "$rest" in
        '[A') echo up ;;
        '[B') echo down ;;
        *)    echo other ;;
      esac ;;
    '') echo ok ;;                  # Enter (remote OK button)
    1|'&') echo 1 ;;                # '&' = 1 on an AZERTY keyboard without Shift
    2|'é') echo 2 ;;
    k|K|z|Z) echo up ;;
    j|J|s|S) echo down ;;
    *) echo other ;;
  esac
}

# --- Main loop -------------------------------------------------------------

default_choice() {
  local d
  d="$(cat "$DEFAULT_FILE" 2>/dev/null || true)"
  case "$d" in v1|v2) echo "$d" ;; *) echo v1 ;; esac
}

# Show the menu; the choice is returned in the global CHOICE variable
# (no $(...): the output must reach the screen, not be captured).
menu() {
  local default selected countdown key
  default="$(default_choice)"
  selected="$default"
  countdown="$DELAY"
  clear_blue
  # The countdown never stops: arrows move the selection and restart it, and
  # the SELECTED program boots when it ends. So the menu works even if the
  # remote's OK button is a mouse click (invisible on the text console).
  while :; do
    draw "$selected" "$countdown" "$default"
    key="$(read_key 1)"
    if [ -z "$key" ]; then
      countdown=$(( countdown - 1 ))
      if [ "$countdown" -lt 0 ]; then CHOICE="$selected"; return; fi
      continue
    fi
    case "$key" in
      up|down)
        [ "$selected" = v1 ] && selected=v2 || selected=v1
        countdown="$DELAY" ;;
      1) CHOICE=v1; return ;;
      2) CHOICE=v2; return ;;
      ok) CHOICE="$selected"; return ;;
    esac
  done
}

main() {
  local choice
  while :; do
    CHOICE=v1
    menu || CHOICE=v1
    choice="$CHOICE"
    printf '%s[0m%s[2J%s[H' "$E" "$E" "$E"
    case "$choice" in
      v2) launch_v2 || true ;;
      *)  launch_v1 || true ;;
    esac
    [ "$DRY_RUN" = 1 ] && return 0
    sleep 1
  done
}

# Safety net: if the script fails, boot v1 as before.
if ! main; then
  startx
fi
