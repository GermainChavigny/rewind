#!/usr/bin/env bash
# tv-switch — choose which program the TV boots by default.
#
#   tv-switch            show the current default
#   tv-switch v1|v2      change the default
#   tv-switch v2 --now   change it and restart the graphical session right away
set -eu

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rewind"
DEFAULT_FILE="$CONF_DIR/boot-default"

current() { cat "$DEFAULT_FILE" 2>/dev/null || echo v1; }

case "${1:-}" in
  "")
    echo "Default program: $(current)" ;;
  v1|v2)
    mkdir -p "$CONF_DIR"
    echo "$1" > "$DEFAULT_FILE"
    echo "Default program: $1"
    if [ "${2:-}" = "--now" ]; then
      # Ending the current graphical session brings back the boot menu, which
      # then starts the new default.
      pkill -x Xorg 2>/dev/null || true
      pkill -x cage 2>/dev/null || true
      echo "Graphical session restarted."
    fi ;;
  *)
    echo "Usage: tv-switch [v1|v2] [--now]" >&2
    exit 2 ;;
esac
